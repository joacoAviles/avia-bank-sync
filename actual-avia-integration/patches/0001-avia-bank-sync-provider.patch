+// AVIA Bank Sync — proveedor bancario propio (Avia Rockets).
+export type SyncServerAviaAccount = {
+  balance: number;
+  account_id: string;
+  institution?: string;
+  orgDomain?: string | null;
+  orgId?: string;
+  name: string;
+};
+
+export type AviaInstitution = {
+  id: string;
+  name: string;
+  available: boolean;
+  reason: string | null;
+  doc: string | null;
+  testData: boolean;
+  authMethod?: 'none' | 'portal_login';
+};
+
+export type AviaLoginState =
+  | 'starting'
+  | 'filling'
+  | 'submitted'
+  | 'needs_user'
+  | 'succeeded'
+  | 'failed'
+  | 'cancelled'
+  | 'expired';
+
+export type AviaLogin = {
+  id: string;
+  bank: string;
+  bankName: string;
+  state: AviaLoginState;
+  message: string;
+  hint: string | null;
+  errorCode: string | null;
+  result: { connectionId: string } | null;
+  rut: string;
+  viewport: { width: number; height: number };
+  screenshot?: string;
+  screenshotAt?: number;
+  error_code?: string;
+  reason?: string;
+};
+
+export type AviaConnection = {
+  id: string;
+  label: string;
+  bank: string;
+  bank_id: string;
+  status: 'connected' | 'authorization_required' | 'error' | 'disconnected';
+  last_error: string | null;
+  last_success_at: string | null;
+  accounts: number;
+};
+
+export type AviaStatus = {
+  configured: boolean;
+  reachable: boolean;
+  state:
+    | 'not_configured'
+    | 'connected'
+    | 'syncing'
+    | 'synchronized'
+    | 'error'
+    | 'authorization_required';
+  connections?: AviaConnection[];
+  institutions?: AviaInstitution[];
+  lastSuccessfulSync?: string | null;
+  nextScheduledSync?: string | null;
+  isStale?: boolean;
+  linkedAccounts?: number;
+  importedTransactions?: number;
+  needsReview?: number;
+  reason?: string;
+  error?: string;
+};
