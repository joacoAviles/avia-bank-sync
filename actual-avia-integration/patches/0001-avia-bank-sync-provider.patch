@@ -0,0 +1,186 @@
+import request from 'supertest';
+
+import { handlers } from './app-avia';
+
+const ADMIN = 'valid-token-admin';
+const USER = 'valid-token-user';
+
+function mockFetch(
+  impl: (url: string, init: RequestInit) => { status: number; body: unknown },
+) {
+  return vi.spyOn(globalThis, 'fetch').mockImplementation(async (url, init) => {
+    const { status, body } = impl(String(url), init ?? {});
+    return new Response(JSON.stringify(body), { status });
+  });
+}
+
+beforeEach(() => {
+  process.env.AVIA_SERVER_URL = 'http://avia-api:8000/';
+  process.env.AVIA_API_TOKEN = 'x'.repeat(40);
+});
+
+afterEach(() => {
+  delete process.env.AVIA_SERVER_URL;
+  delete process.env.AVIA_API_TOKEN;
+  vi.restoreAllMocks();
+});
+
+it('requires a valid Actual session', async () => {
+  const res = await request(handlers)
+    .post('/status')
+    .set('x-actual-token', 'invalid-token');
+  expect(res.status).toBe(401);
+});
+
+it('reports not configured when env vars are missing', async () => {
+  delete process.env.AVIA_SERVER_URL;
+  const res = await request(handlers)
+    .post('/status')
+    .set('x-actual-token', USER)
+    .expect(200);
+  expect(res.body.data).toMatchObject({ configured: false, reachable: false });
+});
+
+it('proxies status with the service token and never returns it', async () => {
+  const f = mockFetch(url => ({
+    status: 200,
+    body: url.endsWith('/v1/institutions')
+      ? { institutions: [{ id: 'sandbox', available: true }] }
+      : { configured: true, state: 'synchronized' },
+  }));
+  const res = await request(handlers)
+    .post('/status')
+    .set('x-actual-token', USER)
+    .expect(200);
+  expect(res.body.data).toMatchObject({
+    configured: true,
+    reachable: true,
+    institutions: [{ id: 'sandbox' }],
+  });
+  expect(JSON.stringify(res.body)).not.toContain('x'.repeat(40));
+  const [url, init] = f.mock.calls[0];
+  expect(String(url)).toBe('http://avia-api:8000/v1/status');
+  expect((init?.headers as Record<string, string>).Authorization).toBe(
+    `Bearer ${'x'.repeat(40)}`,
+  );
+});
+
+it('forwards transactions with the Actual account id', async () => {
+  const f = mockFetch(() => ({
+    status: 200,
+    body: { transactions: { all: [] } },
+  }));
+  await request(handlers)
+    .post('/transactions')
+    .set('x-actual-token', USER)
+    .send({
+      accountId: 'bank-acct',
+      startDate: '2026-11-01T00:00:00Z',
+      actualAccountId: 'act-1',
+    })
+    .expect(200);
+  expect(JSON.parse(String(f.mock.calls[0][1]?.body))).toEqual({
+    accountId: 'bank-acct',
+    startDate: '2026-11-01',
+    actualAccountId: 'act-1',
+  });
+});
+
+it('maps AVIA errors into data.error_code for loot-core', async () => {
+  mockFetch(() => ({
+    status: 200,
+    body: {
+      error_type: 'ITEM_ERROR',
+      error_code: 'ITEM_LOGIN_REQUIRED',
+      reason: 'reauth',
+    },
+  }));
+  // 200 + error body: AVIA devuelve el par de reautorización con 200
+  const ok = await request(handlers)
+    .post('/transactions')
+    .set('x-actual-token', USER)
+    .send({ accountId: 'a', startDate: '2026-11-01' })
+    .expect(200);
+  expect(ok.body.data.error_code).toBe('ITEM_LOGIN_REQUIRED');
+
+  vi.restoreAllMocks();
+  mockFetch(() => ({
+    status: 409,
+    body: { error_code: 'INSTITUTION_BLOCKED', reason: 'bloqueado' },
+  }));
+  const res = await request(handlers)
+    .post('/connections/create')
+    .set('x-actual-token', ADMIN)
+    .send({ institution: 'banco-chile' })
+    .expect(200);
+  expect(res.body.data).toMatchObject({
+    error_code: 'INSTITUTION_BLOCKED',
+    reason: 'bloqueado',
+  });
+});
+
+it('only admins can manage connections', async () => {
+  const f = mockFetch(() => ({ status: 201, body: { id: 'c1' } }));
+  for (const path of [
+    '/connections/create',
+    '/connections/delete',
+    '/connections/reauthorize',
+  ]) {
+    await request(handlers)
+      .post(path)
+      .set('x-actual-token', USER)
+      .send({ id: 'c1' })
+      .expect(403);
+  }
+  expect(f).not.toHaveBeenCalled();
+  await request(handlers)
+    .post('/connections/create')
+    .set('x-actual-token', ADMIN)
+    .send({ institution: 'sandbox' })
+    .expect(200);
+  expect(f).toHaveBeenCalledTimes(1);
+});
+
+it('reports unreachable service without crashing', async () => {
