+// ---------------------------------------------------------------------------
+// AVIA Bank Sync (proveedor propio de Avia Rockets). Mismo patrón que Akahu:
+// el cliente habla con el sync-server (/avia/*), que hace de proxy al servicio
+// AVIA en la red Docker interna.
+// ---------------------------------------------------------------------------
+async function linkAviaAccount({
+  externalAccount,
+  upgradingId,
+  offBudget = false,
+  startingDate,
+  startingBalance,
+}: LinkAccountBaseParams & {
+  externalAccount: SyncServerAviaAccount;
+}) {
+  let id;
+
+  const bank = await link.findOrCreateBank(
+    { name: externalAccount.institution ?? 'AVIA Bank Sync' },
+    `avia:${externalAccount.orgId ?? externalAccount.institution ?? 'avia'}`,
+  );
+
+  if (upgradingId) {
+    const accRow = await db.first<db.DbAccount>(
+      'SELECT * FROM accounts WHERE id = ?',
+      [upgradingId],
+    );
+
+    if (!accRow) {
+      throw new Error(`Account with ID ${upgradingId} not found.`);
+    }
+
+    id = accRow.id;
+    await db.update('accounts', {
+      id,
+      account_id: externalAccount.account_id,
+      bank: bank.id,
+      account_sync_source: 'avia',
+    });
+  } else {
+    // Evita cuentas duplicadas si el flujo se repite sobre la misma cuenta bancaria
+    const existing = await db.first<db.DbAccount>(
+      "SELECT * FROM accounts WHERE account_id = ? AND account_sync_source = 'avia' AND tombstone = 0",
+      [externalAccount.account_id],
+    );
+    if (existing) {
+      throw new Error(
+        `La cuenta bancaria ya está vinculada a «${existing.name}» en Actual.`,
+      );
+    }
+    id = uuidv4();
+    await db.insertWithUUID('accounts', {
+      id,
+      account_id: externalAccount.account_id,
+      name: externalAccount.name,
+      official_name: externalAccount.name,
+      bank: bank.id,
+      offbudget: offBudget ? 1 : 0,
+      account_sync_source: 'avia',
+    });
+    await db.insertPayee({
+      name: '',
+      transfer_acct: id,
+    });
+  }
+
+  const syncRes = await bankSync.syncAccount(
+    undefined,
+    undefined,
+    id,
+    externalAccount.account_id,
+    bank.bank_id,
+    startingDate,
+    startingBalance,
+  );
+
+  await handleSyncResponse(syncRes, id);
+
+  connection.send('sync-event', {
+    type: 'success',
+    tables: ['transactions', 'accounts'],
+  });
+
+  return 'ok';
+}
+
+async function aviaPost(path: string, body: Record<string, unknown> = {}) {
+  const userToken = await asyncStorage.getItem('user-token');
+  if (!userToken) {
+    return { error: 'unauthorized' };
+  }
+  const serverConfig = getServer();
+  if (!serverConfig) {
+    throw new Error('Failed to get server config.');
+  }
+  try {
+    return await post(
+      serverConfig.AVIA_SERVER + path,
+      body,
+      { 'X-ACTUAL-TOKEN': userToken },
+      60000,
+    );
+  } catch {
+    return { error_code: 'TIMED_OUT' };
+  }
+}
+
+async function aviaStatus() {
+  return aviaPost('/status');
+}
+
+async function aviaAccounts() {
+  return aviaPost('/accounts');
+}
+
+async function aviaSync({
+  trigger = 'manual',
+  onlyIfStale = false,
+}: { trigger?: 'manual' | 'actual_open'; onlyIfStale?: boolean } = {}) {
+  return aviaPost('/sync', { trigger, onlyIfStale });
+}
+
+async function aviaConnectionCreate({
+  institution,
+  label,
+  params,
+}: {
+  institution: string;
+  label?: string;
+  params?: Record<string, unknown>;
+}) {
+  return aviaPost('/connections/create', { institution, label, params });
+}
+
+async function aviaConnectionDelete({ id }: { id: string }) {
+  return aviaPost('/connections/delete', { id });
+}
+
+async function aviaConnectionReauthorize({
+  id,
+  params,
+}: {
+  id: string;
+  params?: Record<string, unknown>;
+}) {
+  return aviaPost('/connections/reauthorize', { id, params });
+}
+
+async function aviaLoginStart({
+  institution,
+  rut,
+  password,
+  label,
+  connectionId,
+}: {
+  institution: string;
+  rut?: string;
+  password?: string;
+  label?: string;
+  connectionId?: string;
+}) {
+  return aviaPost('/logins/start', {
+    institution,
+    rut,
+    password,
+    label,
+    connectionId,
+  });
+}
+
+async function aviaLoginStatus({ id }: { id: string }) {
+  return aviaPost('/logins/status', { id });
+}
+
+type AviaLoginInputCommand =
+  | { type: 'click'; x: number; y: number }
+  | { type: 'type'; text: string }
+  | { type: 'key'; key: string }
+  | { type: 'scroll'; dy: number }
+  | { type: 'cancel' };
+
+async function aviaLoginInput({
+  id,
+  input,
+}: {
+  id: string;
+  input: AviaLoginInputCommand;
+}) {
+  return aviaPost('/logins/input', { id, input });
+}
