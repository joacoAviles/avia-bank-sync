diff --git a/packages/sync-server/src/app-avia/app-avia.ts b/packages/sync-server/src/app-avia/app-avia.ts
new file mode 100644
index 000000000..a7aac4430
--- /dev/null
+++ b/packages/sync-server/src/app-avia/app-avia.ts
@@ -0,0 +1,323 @@
+// AVIA Bank Sync — proveedor bancario propio de Avia Rockets.
+//
+// Proxy delgado hacia el servicio AVIA (contenedor independiente en la red
+// Docker interna). El token de servicio vive solo en este servidor
+// (variables de entorno); nunca llega al navegador.
+//
+//   AVIA_SERVER_URL  p. ej. http://avia-api:8000
+//   AVIA_API_TOKEN   mismo valor que en el servicio AVIA (>= 32 caracteres)
+//                    o AVIA_API_TOKEN_FILE (Docker secret)
+import { readFileSync } from 'node:fs';
+
+import express from 'express';
+import type { Request, Response } from 'express';
+
+import { isAdmin } from '#account-db';
+import { handleError } from '#app-gocardless/util/handle-error';
+import {
+  requestLoggerMiddleware,
+  validateSessionMiddleware,
+} from '#util/middlewares';
+
+const app = express();
+export { app as handlers };
+app.use(express.json());
+app.use(requestLoggerMiddleware);
+app.use(validateSessionMiddleware);
+
+// < 120 s del timeout de loot-core para /transactions (puede sincronizar si los datos están viejos)
+const TIMEOUT_MS = 110_000;
+
+function readToken(): string | undefined {
+  const file = process.env.AVIA_API_TOKEN_FILE;
+  if (file) {
+    try {
+      return readFileSync(file, 'utf8').trim();
+    } catch {
+      return undefined;
+    }
+  }
+  return process.env.AVIA_API_TOKEN;
+}
+
+function aviaConfig() {
+  const url = process.env.AVIA_SERVER_URL?.replace(/\/+$/, '');
+  const token = readToken();
+  return url && token ? { url, token } : null;
+}
+
+type AviaResult = {
+  ok: boolean;
+  status: number;
+  body: Record<string, unknown> | null;
+};
+
+async function avia(
+  method: 'GET' | 'POST' | 'DELETE',
+  path: string,
+  body?: unknown,
+): Promise<AviaResult> {
+  const cfg = aviaConfig();
+  if (!cfg) {
+    return {
+      ok: false,
+      status: 503,
+      body: {
+        error_type: 'AVIA',
+        error_code: 'AVIA_NOT_CONFIGURED',
+        reason:
+          'El servidor de Actual no tiene AVIA_SERVER_URL / AVIA_API_TOKEN configurados.',
+      },
+    };
+  }
+  try {
+    const res = await fetch(cfg.url + path, {
+      method,
+      headers: {
+        Authorization: `Bearer ${cfg.token}`,
+        'Content-Type': 'application/json',
+      },
+      body: body === undefined ? undefined : JSON.stringify(body),
+      signal: AbortSignal.timeout(TIMEOUT_MS),
+    });
+    const text = await res.text();
+    let parsed: Record<string, unknown> | null = null;
+    try {
+      parsed = text ? JSON.parse(text) : null;
+    } catch {
+      parsed = { reason: text.slice(0, 200) };
+    }
+    if (parsed && typeof parsed.detail === 'object' && parsed.detail) {
+      parsed = parsed.detail as Record<string, unknown>;
+    }
+    return { ok: res.ok, status: res.status, body: parsed };
+  } catch (error) {
+    return {
+      ok: false,
+      status: 502,
+      body: {
+        error_type: 'AVIA',
+        error_code: 'AVIA_UNREACHABLE',
+        reason:
+          error instanceof Error
+            ? `No se pudo contactar a AVIA Bank Sync: ${error.message}`
+            : 'No se pudo contactar a AVIA Bank Sync',
+      },
+    };
+  }
+}
+
+// Respuesta en el formato que espera loot-core: { status: 'ok', data }.
+// Los errores viajan dentro de data como { error_type, error_code, reason }.
+function reply(res: Response, result: AviaResult, data?: unknown) {
+  if (result.ok) {
+    res.send({ status: 'ok', data: data ?? result.body ?? {} });
+    return;
+  }
+  const b = result.body ?? {};
+  res.send({
+    status: 'ok',
+    data: {
+      error_type: b.error_type ?? 'AVIA',
+      error_code: b.error_code ?? `HTTP_${result.status}`,
+      reason: b.reason ?? 'Error de AVIA Bank Sync',
+      status: 'rejected',
+    },
+  });
+}
+
+function requireAdmin(res: Response): boolean {
+  if (!isAdmin(res.locals.user_id)) {
+    res.status(403).send({
+      status: 'error',
+      reason: 'forbidden',
+      details: 'permission-not-found',
+    });
+    return false;
+  }
+  return true;
+}
+
+app.post(
+  '/status',
+  handleError(async (_req: Request, res: Response) => {
+    if (!aviaConfig()) {
+      res.send({
+        status: 'ok',
+        data: { configured: false, reachable: false, state: 'not_configured' },
+      });
+      return;
+    }
+    const [status, institutions] = await Promise.all([
+      avia('GET', '/v1/status'),
+      avia('GET', '/v1/institutions'),
+    ]);
+    if (!status.ok) {
+      res.send({
+        status: 'ok',
+        data: {
+          configured: false,
+          reachable: false,
+          state: 'error',
+          reason: status.body?.reason,
+        },
+      });
+      return;
+    }
+    res.send({
+      status: 'ok',
+      data: {
+        ...status.body,
+        reachable: true,
+        institutions: institutions.body?.institutions ?? [],
+      },
+    });
+  }),
+);
+
+app.post(
+  '/accounts',
+  handleError(async (_req: Request, res: Response) => {
+    reply(res, await avia('GET', '/v1/accounts'));
+  }),
+);
+
+app.post(
+  '/transactions',
+  handleError(async (req: Request, res: Response) => {
+    const { accountId, startDate, actualAccountId } = req.body || {};
+    if (!accountId || !startDate) {
+      res.send({
+        status: 'ok',
+        data: { error: 'accountId and startDate are required' },
+      });
+      return;
+    }
+    reply(
+      res,
+      await avia('POST', '/v1/transactions', {
+        accountId,
+        startDate: String(startDate).slice(0, 10),
+        actualAccountId: actualAccountId ?? null,
+      }),
+    );
+  }),
+);
+
+app.post(
+  '/sync',
+  handleError(async (req: Request, res: Response) => {
+    const { trigger = 'manual', onlyIfStale = false } = req.body || {};
+    reply(
+      res,
+      await avia('POST', '/v1/sync', {
+        trigger: trigger === 'actual_open' ? 'actual_open' : 'manual',
+        onlyIfStale: Boolean(onlyIfStale),
+      }),
+    );
+  }),
+);
+
+app.post(
+  '/connections/create',
+  handleError(async (req: Request, res: Response) => {
+    if (!requireAdmin(res)) return;
+    const { institution, label, params } = req.body || {};
+    reply(
+      res,
+      await avia('POST', '/v1/connections', {
+        institution,
+        label,
+        params: params ?? {},
+      }),
+    );
+  }),
+);
+
+app.post(
+  '/connections/delete',
+  handleError(async (req: Request, res: Response) => {
+    if (!requireAdmin(res)) return;
+    const { id } = req.body || {};
+    reply(
+      res,
+      await avia('DELETE', `/v1/connections/${encodeURIComponent(id)}`),
+      { deleted: true },
+    );
+  }),
+);
+
+app.post(
+  '/connections/reauthorize',
+  handleError(async (req: Request, res: Response) => {
+    if (!requireAdmin(res)) return;
+    const { id, params } = req.body || {};
+    reply(
+      res,
+      await avia(
+        'POST',
+        `/v1/connections/${encodeURIComponent(id)}/reauthorize`,
+        { params: params ?? {} },
+      ),
+    );
+  }),
+);
+
+// Login asistido a portales bancarios (RUT + clave). La clave viaja solo
+// navegador -> sync-server -> AVIA por la red interna y AVIA la guarda cifrada.
+app.post(
+  '/logins/start',
+  handleError(async (req: Request, res: Response) => {
+    if (!requireAdmin(res)) return;
+    const { institution, rut, password, label, connectionId } = req.body || {};
+    reply(
+      res,
+      await avia('POST', '/v1/logins', {
+        institution,
+        rut: rut ?? '',
+        password: password ?? '',
+        label: label ?? null,
+        connectionId: connectionId ?? null,
+      }),
+    );
+  }),
+);
+
+app.post(
+  '/logins/status',
+  handleError(async (req: Request, res: Response) => {
+    if (!requireAdmin(res)) return;
+    const { id } = req.body || {};
+    reply(res, await avia('GET', `/v1/logins/${encodeURIComponent(id)}`));
+  }),
+);
+
+app.post(
+  '/logins/input',
+  handleError(async (req: Request, res: Response) => {
+    if (!requireAdmin(res)) return;
+    const { id, input } = req.body || {};
+    reply(
+      res,
+      await avia(
+        'POST',
+        `/v1/logins/${encodeURIComponent(id)}/input`,
+        input ?? {},
+      ),
+    );
+  }),
+);
+
+app.post(
+  '/unlink',
+  handleError(async (req: Request, res: Response) => {
+    const { actualAccountId } = req.body || {};
+    reply(
+      res,
+      await avia(
+        'POST',
+        `/v1/actual-accounts/${encodeURIComponent(actualAccountId)}/unlink`,
+      ),
+    );
+  }),
+);
