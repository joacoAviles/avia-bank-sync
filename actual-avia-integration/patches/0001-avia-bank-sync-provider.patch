+// @ts-strict-ignore
+// AVIA Bank Sync: pruebas del camino de sincronización dentro de Actual.
+import * as asyncStorage from '#platform/server/asyncStorage';
+import * as db from '#server/db';
+import { loadMappings } from '#server/db/mappings';
+import { handlers } from '#server/tests/mockSyncServer';
+import { loadRules } from '#server/transactions/transaction-rules';
+import * as monthUtils from '#shared/months';
+
+import { syncAccount } from './sync';
+
+vi.mock('#shared/months', async () => ({
+  ...(await vi.importActual('#shared/months')),
+  currentDay: vi.fn(),
+  currentMonth: vi.fn(),
+}));
+
+const tx = (
+  id: string,
+  date: string,
+  amount: string,
+  payeeName: string,
+  extra: Record<string, unknown> = {},
+) => ({
+  transactionId: id,
+  booked: true,
+  date,
+  payeeName,
+  notes: null,
+  transactionAmount: { amount, currency: 'CLP' },
+  ...extra,
+});
+
+function response(txs, bookedBalanceInteger: number) {
+  return {
+    balances: [],
+    startingBalance: bookedBalanceInteger,
+    transactions: {
+      all: txs,
+      booked: txs.filter(t => t.booked),
+      pending: txs.filter(t => !t.booked),
+    },
+  };
+}
+
+let lastBody = null;
+function mockAvia(byAccount: Record<string, unknown>) {
+  handlers['/avia/transactions'] = data => {
+    lastBody = data;
+    return byAccount[data.accountId];
+  };
+}
+
+function txnsFor(account: string) {
+  return db.all<db.DbViewTransactionInternal>(
+    'SELECT * FROM v_transactions_internal WHERE account = ? AND tombstone = 0 ORDER BY date DESC, amount',
+    [account],
+  );
+}
+
+beforeEach(async () => {
+  vi.resetAllMocks();
+  vi.mocked(monthUtils.currentDay).mockReturnValue('2017-10-15');
+  vi.mocked(monthUtils.currentMonth).mockReturnValue('2017-10');
+  vi.mocked(asyncStorage.getItem).mockResolvedValue('test-token');
+  await global.emptyDatabase()();
+  await loadMappings();
+  await loadRules();
+  db.runQuery(
+    'INSERT INTO banks (id, bank_id, name, tombstone) VALUES (?, ?, ?, 0)',
+    ['bank1', 'avia:sandbox', 'AVIA Sandbox'],
+  );
+  for (const [id, ext, name] of [
+    ['cc', 'ext-cc', 'Cuenta Corriente'],
+    ['tc', 'ext-tc', 'Tarjeta'],
+  ]) {
+    await db.insertAccount({
+      id,
+      name,
+      bank: 'bank1',
+      account_id: ext,
+      account_sync_source: 'avia',
+    });
+    await db.insertPayee({ name: '', transfer_acct: id });
+  }
+});
+
+afterEach(() => {
+  delete handlers['/avia/transactions'];
+});
+
+const checkingTxns = () => [
+  tx('avia:s:cc:P1', '2017-10-14', '-5000.00', 'UBER', { booked: false }),
+  tx('avia:s:cc:B2', '2017-10-05', '-150000.00', 'TARJETA ****4242', {
+    aviaTransferAccountId: 'tc',
+  }),
+  tx('avia:s:cc:B3', '2017-10-03', '-20000.00', 'JUMBO'),
+];
+
+describe('AVIA bank sync', () => {
+  test('initial sync: booked-only starting balance, card payment as transfer', async () => {
+    mockAvia({ 'ext-cc': response(checkingTxns(), 100000000) });
+    await syncAccount(undefined, undefined, 'cc', 'ext-cc', 'avia:sandbox');
+
+    expect(lastBody).toMatchObject({
+      accountId: 'ext-cc',
+      actualAccountId: 'cc',
+    });
+
+    const cc = await txnsFor('cc');
+    const starting = cc.find(t => t.starting_balance_flag);
+    // 1.000.000 contable - (-150.000 - 20.000) contabilizados = 1.170.000 (x100)
+    expect(starting.amount).toBe(117000000);
+    // saldo final en Actual = contable + pendiente
+    expect(cc.reduce((s, t) => s + t.amount, 0)).toBe(100000000 - 500000);
+
+    const payment = cc.find(t => t.imported_id === 'avia:s:cc:B2');
+    const tcPayee = await db.first<{ id: string }>(
+      'SELECT id FROM payees WHERE transfer_acct = ?',
+      ['tc'],
+    );
+    expect(payment.payee).toBe(tcPayee.id);
+    expect(payment.transfer_id).toBeTruthy();
+
+    // Actual creó la contrapartida en la tarjeta: el pago no es un gasto
+    const tc = await txnsFor('tc');
+    expect(tc).toHaveLength(1);
+    expect(tc[0].amount).toBe(15000000);
+
+    const pending = cc.find(t => t.imported_id === 'avia:s:cc:P1');
+    expect(Boolean(pending.cleared)).toBe(false);
+  });
+
+  test('re-sync is idempotent and pending -> booked updates in place', async () => {
+    mockAvia({ 'ext-cc': response(checkingTxns(), 100000000) });
+    await syncAccount(undefined, undefined, 'cc', 'ext-cc', 'avia:sandbox');
+    const before = (await txnsFor('cc')).length;
+
+    await syncAccount(undefined, undefined, 'cc', 'ext-cc', 'avia:sandbox');
+    expect(await txnsFor('cc')).toHaveLength(before);
+
+    // AVIA conserva el mismo transactionId al contabilizar el pendiente
+    const promoted = checkingTxns().map(t =>
+      t.transactionId === 'avia:s:cc:P1'
+        ? { ...t, booked: true, date: '2017-10-15' }
+        : t,
+    );
+    mockAvia({ 'ext-cc': response(promoted, 99500000) });
+    await syncAccount(undefined, undefined, 'cc', 'ext-cc', 'avia:sandbox');
+    const after = await txnsFor('cc');
+    expect(after).toHaveLength(before);
+    expect(
+      Boolean(after.find(t => t.imported_id === 'avia:s:cc:P1').cleared),
+    ).toBe(true);
+  });
+
+  test('card-side payment matches the transfer instead of duplicating it', async () => {
+    mockAvia({
+      'ext-cc': response(checkingTxns(), 100000000),
+      'ext-tc': response(
+        [
+          tx('avia:s:tc:B9', '2017-10-12', '-9490.00', 'NETFLIX'),
+          tx('avia:s:tc:B8', '2017-10-05', '150000.00', 'PAGO RECIBIDO'),
+        ],
+        -2000000,
+      ),
+    });
+    await syncAccount(undefined, undefined, 'cc', 'ext-cc', 'avia:sandbox');
+    await syncAccount(undefined, undefined, 'tc', 'ext-tc', 'avia:sandbox');
+    const tc = await txnsFor('tc');
+    expect(tc.filter(t => t.amount === 15000000)).toHaveLength(1);
+    expect(tc.filter(t => t.amount === -949000)).toHaveLength(1);
+  });
+
+  test('card linked first: existing counterpart is linked, not duplicated', async () => {
+    const withPeer = checkingTxns().map(t =>
+      t.transactionId === 'avia:s:cc:B2'
+        ? { ...t, aviaTransferPeerId: 'avia:s:tc:B8' }
+        : t,
+    );
+    mockAvia({
+      'ext-cc': response(withPeer, 100000000),
+      'ext-tc': response(
+        [tx('avia:s:tc:B8', '2017-10-05', '150000.00', 'PAGO RECIBIDO')],
+        -2000000,
+      ),
+    });
+    await syncAccount(undefined, undefined, 'tc', 'ext-tc', 'avia:sandbox');
+    await syncAccount(undefined, undefined, 'cc', 'ext-cc', 'avia:sandbox');
+
+    const tc = (await txnsFor('tc')).filter(t => !t.starting_balance_flag);
+    expect(tc.filter(t => t.amount === 15000000)).toHaveLength(1);
+    const cardSide = tc.find(t => t.amount === 15000000);
+    const bankSide = (await txnsFor('cc')).find(
+      t => t.imported_id === 'avia:s:cc:B2',
+    );
+    expect(bankSide.transfer_id).toBe(cardSide.id);
+    expect(cardSide.transfer_id).toBe(bankSide.id);
+    const ccPayee = await db.first<{ id: string }>(
+      'SELECT id FROM payees WHERE transfer_acct = ?',
+      ['cc'],
+    );
+    expect(cardSide.payee).toBe(ccPayee.id);
+
+    // re-sincronizar no rompe ni duplica el enlace
+    await syncAccount(undefined, undefined, 'cc', 'ext-cc', 'avia:sandbox');
+    expect(
+      (await txnsFor('tc')).filter(t => t.amount === 15000000),
+    ).toHaveLength(1);
+  });
+
+  test('reauthorization errors surface as ITEM_LOGIN_REQUIRED', async () => {
+    mockAvia({
+      'ext-cc': {
+        error_type: 'ITEM_ERROR',
+        error_code: 'ITEM_LOGIN_REQUIRED',
+        reason: 'Se requiere reautorización',
