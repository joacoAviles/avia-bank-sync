@@ -0,0 +1,36 @@
+import { useCallback, useEffect, useState } from 'react';
+
+import { send } from '@actual-app/core/platform/client/connection';
+import type { AviaStatus } from '@actual-app/core/types/models';
+
+import { useSyncServerStatus } from './useSyncServerStatus';
+
+const EMPTY: AviaStatus = {
+  configured: false,
+  reachable: false,
+  state: 'not_configured',
+};
+
+export function useAviaStatus() {
+  const [aviaStatus, setAviaStatus] = useState<AviaStatus>(EMPTY);
+  const [isLoading, setIsLoading] = useState(false);
+  const status = useSyncServerStatus();
+
+  const refresh = useCallback(async () => {
+    setIsLoading(true);
+    try {
+      const results = (await send('avia-status')) as AviaStatus;
+      setAviaStatus(results && !results.error ? results : EMPTY);
+    } finally {
+      setIsLoading(false);
+    }
+  }, []);
+
+  useEffect(() => {
+    if (status === 'online') {
+      void refresh();
+    }
+  }, [status, refresh]);
+
+  return { aviaStatus, isLoading, refresh };
+}
