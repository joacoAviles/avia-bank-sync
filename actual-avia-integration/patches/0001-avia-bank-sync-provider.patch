diff --git a/packages/desktop-client/src/components/modals/AviaInitialiseModal.tsx b/packages/desktop-client/src/components/modals/AviaInitialiseModal.tsx
new file mode 100644
index 000000000..88f34de37
--- /dev/null
+++ b/packages/desktop-client/src/components/modals/AviaInitialiseModal.tsx
@@ -0,0 +1,607 @@
+// «Bancos chilenos» (AVIA Bank Sync): Set up.
+// - Conexiones existentes: estado, volver a iniciar sesión, eliminar.
+// - Nueva conexión: banco + RUT + clave -> login asistido en el portal del banco.
+//   Si el banco pide un paso humano (Mi Pass, código, CAPTCHA), se muestra la
+//   pantalla del navegador de AVIA en vivo y el usuario lo resuelve aquí.
+import { useCallback, useEffect, useMemo, useRef, useState } from 'react';
+import type { MouseEvent as ReactMouseEvent } from 'react';
+import { Trans, useTranslation } from 'react-i18next';
+
+import { Button, ButtonWithLoading } from '@actual-app/components/button';
+import { Input } from '@actual-app/components/input';
+import { Select } from '@actual-app/components/select';
+import { Text } from '@actual-app/components/text';
+import { theme } from '@actual-app/components/theme';
+import { View } from '@actual-app/components/view';
+import { send } from '@actual-app/core/platform/client/connection';
+import type {
+  AviaConnection,
+  AviaInstitution,
+  AviaLogin,
+} from '@actual-app/core/types/models';
+
+import { Error as ErrorAlert, Information, Warning } from '#components/alerts';
+import {
+  Modal,
+  ModalButtons,
+  ModalCloseButton,
+  ModalHeader,
+} from '#components/common/Modal';
+import { FormField, FormLabel } from '#components/forms';
+import { useAviaStatus } from '#hooks/useAviaStatus';
+import type { Modal as ModalType } from '#modals/modalsSlice';
+
+type AviaInitialiseModalProps = Extract<
+  ModalType,
+  { name: 'avia-init' }
+>['options'];
+
+type LoginInput =
+  | { type: 'click'; x: number; y: number }
+  | { type: 'type'; text: string }
+  | { type: 'key'; key: string }
+  | { type: 'scroll'; dy: number }
+  | { type: 'cancel' };
+
+type AviaResponse = {
+  error?: string;
+  error_code?: string;
+  reason?: string;
+};
+
+const FINAL_STATES = new Set(['succeeded', 'failed', 'cancelled', 'expired']);
+
+function errorOf(res: AviaResponse | undefined): string | null {
+  if (!res) return 'Sin respuesta de AVIA';
+  if (res.error_code) return res.reason || res.error_code;
+  if (res.error) return res.error;
+  return null;
+}
+
+function cleanRut(value: string) {
+  return value.replace(/[^0-9kK]/g, '').toUpperCase();
+}
+
+function formatRut(value: string) {
+  const c = cleanRut(value);
+  if (c.length < 2) return c;
+  const body = c.slice(0, -1);
+  const dv = c.slice(-1);
+  return body.replace(/\B(?=(\d{3})+(?!\d))/g, '.') + '-' + dv;
+}
+
+function isValidRut(value: string) {
+  const c = cleanRut(value);
+  if (c.length < 2 || !/^\d+$/.test(c.slice(0, -1))) return false;
+  let sum = 0;
+  let factor = 2;
+  for (const d of c.slice(0, -1).split('').reverse()) {
+    sum += Number(d) * factor;
+    factor = factor === 7 ? 2 : factor + 1;
+  }
+  const r = 11 - (sum % 11);
+  const dv = r === 11 ? '0' : r === 10 ? 'K' : String(r);
+  return dv === c.slice(-1);
+}
+
+const STATUS_COLOR: Record<AviaConnection['status'], string> = {
+  connected: theme.noticeTextLight,
+  authorization_required: theme.warningText,
+  error: theme.errorText,
+  disconnected: theme.pageTextSubdued,
+};
+
+function LiveLogin({
+  login,
+  onInput,
+}: {
+  login: AviaLogin;
+  onInput: (input: LoginInput) => void;
+}) {
+  const { t } = useTranslation();
+  const [text, setText] = useState('');
+  const imgRef = useRef<HTMLImageElement>(null);
+
+  const onClick = (e: ReactMouseEvent<HTMLImageElement>) => {
+    const img = imgRef.current;
+    if (!img) return;
+    const rect = img.getBoundingClientRect();
+    const x = ((e.clientX - rect.left) / rect.width) * login.viewport.width;
+    const y = ((e.clientY - rect.top) / rect.height) * login.viewport.height;
+    onInput({ type: 'click', x, y });
+  };
+
+  return (
+    <View style={{ gap: 8 }}>
+      <Information>
+        {login.hint ||
+          t(
+            'The bank asks for an extra step. Complete it on the screen below.',
+          )}
+      </Information>
+      {login.screenshot ? (
+        <img
+          ref={imgRef}
+          src={login.screenshot}
+          alt={t('Bank screen')}
+          onClick={onClick}
+          onWheel={e => onInput({ type: 'scroll', dy: e.deltaY })}
+          style={{
+            width: '100%',
+            border: `1px solid ${theme.tableBorder}`,
+            borderRadius: 4,
+            cursor: 'pointer',
+          }}
+        />
+      ) : (
+        <Text style={{ color: theme.pageTextSubdued }}>
+          <Trans>Loading the bank screen…</Trans>
+        </Text>
+      )}
+      <View style={{ flexDirection: 'row', gap: 6, alignItems: 'center' }}>
+        <Input
+          placeholder={t('Type here and press Send (e.g. a code)')}
+          value={text}
+          onChangeValue={setText}
+          onEnter={() => {
+            if (text) onInput({ type: 'type', text });
+            onInput({ type: 'key', key: 'Enter' });
+            setText('');
+          }}
+          style={{ flex: 1 }}
+        />
+        <Button
+          onPress={() => {
+            if (text) onInput({ type: 'type', text });
+            setText('');
+          }}
+        >
+          <Trans>Send</Trans>
+        </Button>
+        <Button onPress={() => onInput({ type: 'key', key: 'Enter' })}>
+          <Trans>Enter</Trans>
+        </Button>
+        <Button onPress={() => onInput({ type: 'key', key: 'Tab' })}>
+          <Trans>Tab</Trans>
+        </Button>
+        <Button onPress={() => onInput({ type: 'key', key: 'Backspace' })}>
+          ⌫
+        </Button>
+      </View>
+      <Text style={{ fontSize: 12, color: theme.pageTextSubdued }}>
+        <Trans>
+          Click on the image to interact with the bank page. AVIA never solves
+          verifications on its own.
+        </Trans>
+      </Text>
+    </View>
+  );
+}
+
+export const AviaInitialiseModal = ({
+  onSuccess,
+}: AviaInitialiseModalProps) => {
+  const { t } = useTranslation();
+  const { aviaStatus, isLoading, refresh } = useAviaStatus();
+  const [institution, setInstitution] = useState<string>('');
+  const [rut, setRut] = useState('');
+  const [password, setPassword] = useState('');
+  const [label, setLabel] = useState('');
+  const [busy, setBusy] = useState<string | null>(null);
+  const [error, setError] = useState<string | null>(null);
+  const [login, setLogin] = useState<AviaLogin | null>(null);
+  const pollRef = useRef<ReturnType<typeof setTimeout> | null>(null);
+
+  const institutions: AviaInstitution[] = useMemo(
+    () => aviaStatus.institutions ?? [],
+    [aviaStatus.institutions],
+  );
+  const available = institutions.filter(i => i.available);
+  const blocked = institutions.filter(i => !i.available);
+  const selected = available.find(i => i.id === institution);
+  const isPortal = selected?.authMethod === 'portal_login';
+  const connections = (aviaStatus.connections ?? []).filter(
+    c => c.status !== 'disconnected',
+  );
+  const portalBankIds = new Set(
+    institutions.filter(i => i.authMethod === 'portal_login').map(i => i.id),
+  );
+
+  useEffect(() => {
+    if (!institution && available.length > 0) {
+      const firstReal =
+        available.find(i => i.authMethod === 'portal_login') ?? available[0];
+      setInstitution(firstReal.id);
+    }
+  }, [available, institution]);
+
+  useEffect(
+    () => () => {
+      if (pollRef.current) clearTimeout(pollRef.current);
+    },
+    [],
+  );
+
+  const STATUS_LABEL: Record<AviaConnection['status'], string> = {
+    connected: t('Connected'),
+    authorization_required: t('Login required'),
+    error: t('Error'),
+    disconnected: t('Disconnected'),
+  };
+
+  const poll = useCallback(
+    (id: string) => {
+      const tick = async () => {
+        const res = (await send('avia-login-status', { id })) as AviaLogin;
+        const err = errorOf(res);
+        if (err) {
+          setError(err);
+          setLogin(null);
+          return;
+        }
+        setLogin(res);
+        if (FINAL_STATES.has(res.state)) {
+          if (res.state === 'succeeded') {
+            setPassword('');
+            await refresh();
+            onSuccess();
+          }
+          return;
+        }
+        pollRef.current = setTimeout(
+          tick,
+          res.state === 'needs_user' ? 900 : 1200,
+        );
+      };
+      void tick();
+    },
+    [onSuccess, refresh],
+  );
+
+  async function startLogin(opts: {
+    institution: string;
+    rut?: string;
+    password?: string;
+    label?: string;
+    connectionId?: string;
+  }) {
+    setError(null);
+    setLogin(null);
+    setBusy(opts.connectionId ? `relogin-${opts.connectionId}` : 'login');
+    try {
+      const res = (await send('avia-login-start', opts)) as AviaLogin;
+      const err = errorOf(res);
+      if (err) {
+        setError(err);
+        return;
+      }
+      setLogin(res);
+      poll(res.id);
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  async function run(key: string, fn: () => Promise<AviaResponse>) {
+    setBusy(key);
+    setError(null);
+    try {
+      const err = errorOf(await fn());
+      if (err) {
+        setError(err);
+        return false;
+      }
+      await refresh();
+      return true;
+    } finally {
+      setBusy(null);
+    }
+  }
+
+  const sendInput = (input: LoginInput) => {
+    if (login) void send('avia-login-input', { id: login.id, input });
+  };
+
+  const loginActive = login && !FINAL_STATES.has(login.state);
+  const rutOk = isValidRut(rut);
+
+  return (
+    <Modal
+      name="avia-init"
+      containerProps={{
+        style: { width: login?.state === 'needs_user' ? 820 : 580 },
+      }}
+    >
+      {({ state }) => (
+        <>
+          <ModalHeader
+            title={t('Chilean banks')}
+            rightContent={<ModalCloseButton onPress={() => state.close()} />}
+          />
+          <View style={{ gap: 12 }}>
+            {!isLoading && !aviaStatus.reachable && (
+              <ErrorAlert>
+                {aviaStatus.reason ||
+                  t(
+                    'The AVIA service is not reachable. Check AVIA_SERVER_URL and AVIA_API_TOKEN on the Actual server.',
+                  )}
+              </ErrorAlert>
+            )}
+
+            {login ? (
+              <View style={{ gap: 10 }}>
+                <Text style={{ fontWeight: 600 }}>
+                  {login.bankName} · {login.rut}
+                </Text>
+                {login.state === 'needs_user' ? (
+                  <LiveLogin login={login} onInput={sendInput} />
+                ) : login.state === 'succeeded' ? (
+                  <Information>
+                    <Trans>
+                      Signed in. The session is stored encrypted in AVIA.
+                    </Trans>
+                  </Information>
+                ) : FINAL_STATES.has(login.state) ? (
+                  <ErrorAlert>{login.message}</ErrorAlert>
+                ) : (
+                  <Text>{login.message}</Text>
+                )}
+                {loginActive && login.state === 'needs_user' && (
+                  <Text style={{ fontSize: 12, color: theme.pageTextSubdued }}>
+                    {login.message}
+                  </Text>
+                )}
+              </View>
+            ) : (
+              <>
+                {connections.length > 0 && (
+                  <View style={{ gap: 6 }}>
+                    <Text style={{ fontWeight: 600 }}>
+                      <Trans>Connections</Trans>
+                    </Text>
+                    {connections.map(c => (
+                      <View
+                        key={c.id}
+                        style={{
+                          flexDirection: 'row',
+                          alignItems: 'center',
+                          gap: 8,
+                          padding: '6px 8px',
+                          border: `1px solid ${theme.tableBorder}`,
+                          borderRadius: 4,
+                        }}
+                      >
+                        <View style={{ flex: 1 }}>
+                          <Text>
+                            {c.bank} · {c.label}
+                          </Text>
+                          <Text
+                            style={{
+                              fontSize: 12,
+                              color: STATUS_COLOR[c.status],
+                            }}
+                          >
+                            {STATUS_LABEL[c.status]}
+                            {c.last_success_at
+                              ? ' · ' +
+                                t('Last sync: {{date}}', {
+                                  date: new Date(
+                                    c.last_success_at,
+                                  ).toLocaleString(),
+                                })
+                              : ''}
+                          </Text>
+                          {c.last_error && (
+                            <Text
+                              style={{ fontSize: 12, color: theme.errorText }}
+                            >
+                              {c.last_error}
+                            </Text>
+                          )}
+                        </View>
+                        {portalBankIds.has(c.bank_id) && (
+                          <ButtonWithLoading
+                            isLoading={busy === `relogin-${c.id}`}
+                            onPress={() =>
+                              void startLogin({
+                                institution: c.bank_id,
+                                connectionId: c.id,
+                              })
+                            }
+                          >
+                            <Trans>Sign in again</Trans>
+                          </ButtonWithLoading>
+                        )}
+                        <ButtonWithLoading
+                          variant="bare"
+                          isLoading={busy === `del-${c.id}`}
+                          onPress={() =>
+                            void run(`del-${c.id}`, () =>
+                              send('avia-connection-delete', { id: c.id }),
+                            )
+                          }
+                        >
+                          <Trans>Remove</Trans>
+                        </ButtonWithLoading>
+                      </View>
+                    ))}
+                  </View>
+                )}
+
+                {available.length > 0 && (
+                  <View style={{ gap: 8 }}>
+                    <Text style={{ fontWeight: 600 }}>
+                      <Trans>Connect a bank</Trans>
+                    </Text>
+                    <FormField>
+                      <FormLabel title={t('Bank:')} htmlFor="avia-inst" />
+                      <Select
+                        id="avia-inst"
+                        options={available.map(i => [i.id, i.name] as const)}
+                        value={institution}
+                        onChange={setInstitution}
+                      />
+                    </FormField>
+                    {selected?.testData && (
+                      <Information>
+                        <Trans>
+                          This institution only contains fictitious data for
+                          testing. Use a test budget file.
+                        </Trans>
+                      </Information>
+                    )}
+                    {isPortal && (
+                      <>
+                        <FormField>
+                          <FormLabel title={t('RUT:')} htmlFor="avia-rut" />
+                          <Input
+                            id="avia-rut"
+                            placeholder="12.345.678-9"
+                            value={rut}
+                            onChangeValue={v => setRut(formatRut(v))}
+                            autoComplete="off"
+                          />
+                          {rut.length > 3 && !rutOk && (
+                            <Text
+                              style={{ fontSize: 12, color: theme.errorText }}
+                            >
+                              <Trans>Invalid RUT</Trans>
+                            </Text>
+                          )}
+                        </FormField>
+                        <FormField>
+                          <FormLabel
+                            title={t('Password:')}
+                            htmlFor="avia-password"
+                          />
+                          <Input
+                            id="avia-password"
+                            type="password"
+                            value={password}
+                            onChangeValue={setPassword}
+                            autoComplete="off"
+                          />
+                        </FormField>
+                        <Text
+                          style={{ fontSize: 12, color: theme.pageTextSubdued }}
+                        >
+                          <Trans>
+                            AVIA signs in on the bank website with these
+                            credentials and stores them encrypted on your
+                            server. If the bank asks for Mi Pass or a code, you
+                            approve it here.
+                          </Trans>
+                        </Text>
+                      </>
+                    )}
+                    <FormField>
+                      <FormLabel
+                        title={t('Connection name (optional):')}
+                        htmlFor="avia-label"
+                      />
+                      <Input
+                        id="avia-label"
+                        value={label}
+                        onChangeValue={setLabel}
+                      />
+                    </FormField>
+                    {selected?.reason && <Warning>{selected.reason}</Warning>}
+                  </View>
+                )}
+
+                {blocked.length > 0 && (
+                  <Warning>
+                    <View style={{ gap: 4 }}>
+                      {blocked.map(i => (
+                        <Text key={i.id} style={{ fontSize: 12 }}>
+                          <strong>{i.name}:</strong> {i.reason}
+                        </Text>
+                      ))}
+                    </View>
+                  </Warning>
+                )}
+              </>
+            )}
+
+            {error && <ErrorAlert>{error}</ErrorAlert>}
+          </View>
+
+          <ModalButtons>
+            {login ? (
+              loginActive ? (
+                <Button
+                  onPress={() => {
+                    sendInput({ type: 'cancel' });
+                  }}
+                >
+                  <Trans>Cancel sign-in</Trans>
+                </Button>
+              ) : (
+                <>
+                  <Button
+                    onPress={() => setLogin(null)}
+                    style={{ marginRight: 10 }}
+                  >
+                    <Trans>Back</Trans>
+                  </Button>
+                  <Button variant="primary" onPress={() => state.close()}>
+                    <Trans>Done</Trans>
+                  </Button>
+                </>
+              )
+            ) : (
+              <>
+                <Button
+                  onPress={() => state.close()}
+                  style={{ marginRight: 10 }}
+                >
+                  <Trans>Close</Trans>
+                </Button>
+                {available.length > 0 &&
+                  (isPortal ? (
+                    <ButtonWithLoading
+                      variant="primary"
+                      isDisabled={!rutOk || !password || !aviaStatus.reachable}
+                      isLoading={busy === 'login'}
+                      onPress={() =>
+                        void startLogin({
+                          institution,
+                          rut,
+                          password,
+                          label: label || undefined,
+                        })
+                      }
+                    >
+                      <Trans>Sign in to the bank</Trans>
+                    </ButtonWithLoading>
+                  ) : (
+                    <ButtonWithLoading
+                      variant="primary"
+                      isDisabled={!institution || !aviaStatus.reachable}
+                      isLoading={busy === 'create'}
+                      onPress={() =>
+                        void run('create', () =>
+                          send('avia-connection-create', {
+                            institution,
+                            label: label || undefined,
+                            params: {},
+                          }),
+                        ).then(ok => {
+                          if (ok) {
+                            onSuccess();
+                            state.close();
+                          }
+                        })
+                      }
+                    >
+                      <Trans>Connect</Trans>
+                    </ButtonWithLoading>
+                  ))}
+              </>
+            )}
+          </ModalButtons>
+        </>
+      )}
+    </Modal>
+  );
+};
