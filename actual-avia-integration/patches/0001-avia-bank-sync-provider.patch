+type AviaLinkRow = { id: string; transfer_id: string | null; amount: number };
+
+type AviaTransferLink = {
+  importedId: string;
+  peerId: string;
+  targetAccount: string;
+  targetPayee: string;
+};
+
+async function linkAviaTransfers(
+  acctId: AccountEntity['id'],
+  links: AviaTransferLink[],
+) {
+  if (!links?.length) return;
+  const own = await db.first<{ id: string }>(
+    'SELECT id FROM payees WHERE transfer_acct = ? AND tombstone = 0',
+    [acctId],
+  );
+  if (!own) return;
+  const updated = [];
+  for (const link of links) {
+    const trans = await db.first<AviaLinkRow>(
+      'SELECT id, transfer_id, amount FROM v_transactions_internal WHERE account = ? AND imported_id = ? AND tombstone = 0',
+      [acctId, link.importedId],
+    );
+    const peer = await db.first<AviaLinkRow>(
+      'SELECT id, transfer_id, amount FROM v_transactions_internal WHERE id = ? AND tombstone = 0',
+      [link.peerId],
+    );
+    if (!trans || !peer || trans.transfer_id || peer.transfer_id) continue;
+    if (trans.amount !== -peer.amount) continue;
+    // Igual que «Make transfer»: la categoría solo se limpia si ambas cuentas
+    // son del mismo tipo (ambas dentro o ambas fuera del presupuesto).
+    const budgets = await db.all<{ offbudget: number }>(
+      'SELECT offbudget FROM accounts WHERE id IN (?, ?)',
+      [acctId, link.targetAccount],
+    );
+    const clear =
+      budgets.length === 2 && budgets[0].offbudget === budgets[1].offbudget;
+    updated.push(
+      {
+        id: trans.id,
+        payee: link.targetPayee,
+        transfer_id: peer.id,
+        ...(clear ? { category: null } : {}),
+      },
+      {
+        id: peer.id,
+        payee: own.id,
+        transfer_id: trans.id,
+        ...(clear ? { category: null } : {}),
+      },
+    );
+  }
+  if (updated.length) {
+    await runMutator(() =>
+      batchUpdateTransactions({ updated, runTransfers: false }),
+    );
+  }
+}
+
+// AVIA Bank Sync: el servicio AVIA ya deduplica, normaliza y concilia; aquí solo
+// se traduce su respuesta al contrato BankSyncResponse. Los pagos de tarjeta
+// emparejados por AVIA llegan con `aviaTransferAccountId` (cuenta Actual de la
+// tarjeta) y se registran con el payee de transferencia de esa cuenta, de modo
+// que Actual crea la contrapartida y no los cuenta como gasto.
+async function downloadAviaTransactions(
+  acctId: AccountEntity['id'],
+  since: string,
+  actualAccountId: AccountEntity['id'],
+) {
+  const userToken = await asyncStorage.getItem('user-token');
+  if (!userToken) return;
+
+  logger.log('Pulling transactions from AVIA Bank Sync');
+
+  const res = await post(
+    getServer().AVIA_SERVER + '/transactions',
+    {
+      accountId: acctId,
+      startDate: since,
+      actualAccountId,
+    },
+    {
+      'X-ACTUAL-TOKEN': userToken,
+    },
+    120000,
+  );
+
+  if (res.error_code) {
+    throw BankSyncError(res.error_type, res.error_code, { reason: res.reason });
+  } else if ('error' in res) {
+    throw BankSyncError('Connection', res.error);
+  }
+
+  const singleRes = res as BankSyncResponse;
+  const transferPayees = new Map<string, string | null>();
+  // Pares cuya contrapartida YA existe en la otra cuenta (se importó antes por su
+  // propio bank sync): no se fija el payee (crearía un duplicado); se enlazan
+  // después de importar, igual que «Make transfer» de la interfaz.
+  const transferLinks: AviaTransferLink[] = [];
+  for (const trans of singleRes.transactions.all as Array<
+    BankSyncResponse['transactions']['all'][number] & {
+      aviaTransferAccountId?: string;
+      aviaTransferPeerId?: string;
+      payee?: string;
+    }
+  >) {
+    const target = trans.aviaTransferAccountId;
+    if (!target || target === actualAccountId) continue;
+    if (!transferPayees.has(target)) {
+      const row = await db.first<{ id: string }>(
+        'SELECT p.id FROM payees p JOIN accounts a ON a.id = p.transfer_acct WHERE p.transfer_acct = ? AND p.tombstone = 0 AND a.tombstone = 0 AND a.closed = 0',
+        [target],
+      );
+      transferPayees.set(target, row?.id ?? null);
+    }
+    const payeeId = transferPayees.get(target);
+    if (!payeeId) continue;
+    const peer = trans.aviaTransferPeerId
+      ? await db.first<{ id: string; transfer_id: string | null }>(
+          'SELECT id, transfer_id FROM v_transactions_internal WHERE account = ? AND imported_id = ? AND tombstone = 0',
+          [target, trans.aviaTransferPeerId],
+        )
+      : null;
+    if (peer) {
+      delete trans.payee;
+      if (!peer.transfer_id) {
+        transferLinks.push({
+          importedId: trans.transactionId,
+          peerId: peer.id,
+          targetAccount: target,
+          targetPayee: payeeId,
+        });
+      }
+    } else {
+      trans.payee = payeeId;
+    }
+  }
+
+  const retVal = {
+    transactions: singleRes.transactions.all,
+    accountBalance: singleRes.balances,
+    startingBalance: singleRes.startingBalance,
+    aviaTransferLinks: transferLinks,
+  };
+
+  logger.log('Response:', {
+    transactions: retVal.transactions.length,
+    startingBalance: retVal.startingBalance,
+  });
+  return retVal;
+}
