# Copiar a .env y ajustar. Los secretos NO van aquí: van en ./secrets (scripts/generate-secrets.sh)
AVIA_VERSION=1.0.0
ACTUAL_AVIA_VERSION=26.11.0-avia.1
AVIA_DATA_DIR=/volume1/docker/avia-bank-sync
AVIA_BACKUP_DIR=/volume1/docker/avia-bank-sync/backups
ACTUAL_NETWORK=actual-budget_default
# Sync ID del presupuesto: Actual > Ajustes > Mostrar ajustes avanzados > Sync ID
ACTUAL_BUDGET_SYNC_ID=
# Conectores habilitados (sandbox = datos ficticios; los bancos usan login con RUT y clave)
AVIA_ENABLED_CONNECTORS=sandbox,banco_chile,itau,ripley,banco_estado
AVIA_DAILY_SYNC_HOUR=6
AVIA_DAILY_SYNC_MINUTE=15
AVIA_FRESHNESS_HOURS=12
AVIA_INITIAL_HISTORY_DAYS=90
AVIA_PANEL_PORT=8070
AVIA_BACKUP_HOUR=3
AVIA_BACKUP_RETENTION_DAYS=30
# Opcional: ntfy u otro webhook para avisar errores de sincronización
AVIA_NOTIFY_WEBHOOK_URL=
